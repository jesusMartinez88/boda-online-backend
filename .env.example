# ============================================================================
# Database
# ============================================================================
TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=<token>
DB_PATH=file:data/wedding.db

# ============================================================================
# Server
# ============================================================================
PORT=3000
NODE_ENV=development
ORIGIN_URL=http://localhost:4200

# ============================================================================
# Email (Resend)
# ============================================================================
EMAILOWNER=you@example.com
RESEND_API_KEY=re_xxx
SEND_EMAIL_ON_GUEST_CREATE=true
SEND_CONFIRMATION_EMAIL=false

# ============================================================================
# Auth
# ============================================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<32-byte-hex>
ADMIN_PASSWORD=<strong-password>

# ============================================================================
# AI (OpenRouter)
# ============================================================================
OPENROUTER_API_KEY=sk-or-v1-<key>

# ============================================================================
# Stripe (pagos)
# ----------------------------------------------------------------------------
# 1) Crea una cuenta en https://dashboard.stripe.com
# 2) Modo test: usa las claves "test_" del dashboard de test.
#    Modo live: usa las claves "live_" cuando estés listo para producción.
# 3) En el dashboard de Stripe (modo test/live) crea el webhook apuntando a:
#      https://<tu-dominio>/api/payments/webhook
#    Apunta los eventos: payment_intent.succeeded,
#    payment_intent.processing, payment_intent.payment_failed,
#    payment_intent.canceled.
# 4) Copia el "Signing secret" del webhook (whsec_xxx) en STRIPE_WEBHOOK_SECRET.
# 5) Para desarrollo local, USA LA STRIPE CLI (no hace falta tocar el dashboard):
#      pnpm dev:stripe
#    Ese script arranca `stripe listen --forward-to localhost:3000/api/payments/webhook`,
#    captura el whsec_xxx temporal que imprime la CLI y lo escribe en .env.
#    Mantén esa terminal abierta mientras desarrollas; al cerrarla restaura el valor.
#    La CLI requiere `stripe login` la primera vez.
# ============================================================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Importe del plan (en céntimos). Por defecto 5900 = 59,00 EUR.
PAYMENT_AMOUNT_CENTS=5900
PAYMENT_CURRENCY=eur
PAYMENT_DESCRIPTION=BodasOnline · Plan Pareja Completo (pago único)